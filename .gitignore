# ==============================================================
# AI-Threat-Modeling-Tool — .gitignore
# ==============================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/
.env

# Distribution / build artefacts
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Pytest cache
.pytest_cache/
.cache/
htmlcov/
*.cover
.coverage
coverage.xml

# IDE / editor folders
.idea/
.vscode/
*.suo
*.user

# Streamlit local config (keep .streamlit/config.toml out of repo
# to avoid exposing server settings)
.streamlit/secrets.toml

# macOS metadata
.DS_Store
.AppleDouble

# Windows thumbnails
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs & temp files
*.log
*.tmp
*.bak
*.swp
